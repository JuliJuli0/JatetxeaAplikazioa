<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:JatetxeaAplikazioa.Views"
       x:Class="JatetxeaAplikazioa.AppShell"
       Title="Errezeten Kudeaketa"
       FlyoutBehavior="Flyout"
       Shell.BackgroundColor="{StaticResource Zuria}"
       Shell.ForegroundColor="{StaticResource Terracota}"
       Shell.TitleColor="{StaticResource Txokolatea}"
       FlyoutBackgroundColor="{StaticResource Krema}">

    <!-- ========================================================== -->
    <!-- ALBOKO MENUKO NABIGAZIO OINARRARRIA (FLYOUT MENU) -->
    <!-- ========================================================== -->

    <!-- Errezetak kudeatzeko pantaila nagusia -->
    <ShellContent Title="Errezetak"
                  Route="RecipesPage"
                  ContentTemplate="{DataTemplate views:RecipesPage}" />

    <!-- Sukaldariak kudeatzeko pantaila -->
    <ShellContent Title="Sukaldariak"
                  Route="ChefsPage"
                  ContentTemplate="{DataTemplate views:ChefsPage}" />
</Shell>